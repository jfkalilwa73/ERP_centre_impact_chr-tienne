{
    "openapi": "3.0.0",
    "info": {
        "title": "Documentation API ERP Centre Impact Chrétien",
        "description": "API pour la gestion de l'ERP. Authentification SPA : cookie de session Sanctum, pas de Bearer token.",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8000",
            "description": "Serveur API principal"
        }
    ],
    "paths": {
        "/api/v1/acces/comptes/{user}/roles": {
            "post": {
                "tags": [
                    "Accès"
                ],
                "summary": "Attribuer un rôle à un compte",
                "description": "Crée une affectation active dans affecter_role_metier. Nécessite une session cookie. {user} est l'id numérique du compte Laravel.",
                "operationId": "fa63546203c5463290cad97bb70c4d37",
                "parameters": [
                    {
                        "name": "user",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "id_role"
                                ],
                                "properties": {
                                    "id_role": {
                                        "type": "string",
                                        "format": "uuid",
                                        "example": "63c18b33-2f90-4d2e-a12a-8147bfe50d5b"
                                    },
                                    "date_debut": {
                                        "type": "string",
                                        "format": "date-time",
                                        "nullable": true
                                    },
                                    "date_fin": {
                                        "type": "string",
                                        "format": "date-time",
                                        "nullable": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Rôle attribué"
                    },
                    "401": {
                        "description": "Non authentifié"
                    },
                    "404": {
                        "description": "Compte ou rôle introuvable"
                    },
                    "409": {
                        "description": "Rôle déjà attribué à ce compte"
                    },
                    "422": {
                        "description": "Données invalides"
                    }
                },
                "security": [
                    {
                        "cookieAuth": []
                    }
                ]
            }
        },
        "/api/v1/acces/roles/{role}/permissions": {
            "post": {
                "tags": [
                    "Accès"
                ],
                "summary": "Attribuer une permission à un rôle",
                "description": "Lie une permission à un rôle dans attribuer_permission. Nécessite une session cookie. {role} est l'UUID id_role.",
                "operationId": "9d950d3d20e06813dab1158da35e374d",
                "parameters": [
                    {
                        "name": "role",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid",
                            "example": "63c18b33-2f90-4d2e-a12a-8147bfe50d5b"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "id_permission"
                                ],
                                "properties": {
                                    "id_permission": {
                                        "type": "string",
                                        "format": "uuid",
                                        "example": "11111111-1111-1111-1111-111111111111"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Permission attribuée"
                    },
                    "401": {
                        "description": "Non authentifié"
                    },
                    "404": {
                        "description": "Rôle ou permission introuvable"
                    },
                    "409": {
                        "description": "Permission déjà attribuée à ce rôle"
                    },
                    "422": {
                        "description": "Données invalides"
                    }
                },
                "security": [
                    {
                        "cookieAuth": []
                    }
                ]
            }
        },
        "/api/v1/acces/permissions": {
            "post": {
                "tags": [
                    "Accès"
                ],
                "summary": "Créer une permission",
                "description": "Crée une permission métier (permission_metier). Nécessite une session cookie. Le code et le couple module+action doivent être uniques.",
                "operationId": "6761138d2fb126ddc02b14ef2c11b9d2",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "code",
                                    "module",
                                    "action"
                                ],
                                "properties": {
                                    "code": {
                                        "type": "string",
                                        "example": "finances.read"
                                    },
                                    "module": {
                                        "type": "string",
                                        "example": "finances"
                                    },
                                    "action": {
                                        "type": "string",
                                        "example": "read"
                                    },
                                    "description": {
                                        "type": "string",
                                        "example": "Consulter les données financières",
                                        "nullable": true
                                    },
                                    "actif": {
                                        "type": "boolean",
                                        "example": true,
                                        "nullable": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Permission créée"
                    },
                    "401": {
                        "description": "Non authentifié"
                    },
                    "409": {
                        "description": "Code ou couple module+action déjà utilisé"
                    },
                    "422": {
                        "description": "Données invalides"
                    }
                },
                "security": [
                    {
                        "cookieAuth": []
                    }
                ]
            }
        },
        "/api/v1/acces/roles": {
            "post": {
                "tags": [
                    "Accès"
                ],
                "summary": "Créer un rôle métier",
                "description": "Crée un rôle (role_metier). Nécessite une session cookie. Le code doit être unique.",
                "operationId": "74842a32f6423bfc7ecd079d9fa8ff89",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "code",
                                    "nom"
                                ],
                                "properties": {
                                    "code": {
                                        "type": "string",
                                        "example": "ADMIN_FONCTIONNEL"
                                    },
                                    "nom": {
                                        "type": "string",
                                        "example": "Administrateur Fonctionnel"
                                    },
                                    "description": {
                                        "type": "string",
                                        "example": "Gestion globale de l'ERP",
                                        "nullable": true
                                    },
                                    "niveau_confidentialite": {
                                        "type": "integer",
                                        "example": 3,
                                        "nullable": true
                                    },
                                    "actif": {
                                        "type": "boolean",
                                        "example": true,
                                        "nullable": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Rôle créé"
                    },
                    "401": {
                        "description": "Non authentifié"
                    },
                    "409": {
                        "description": "Code de rôle déjà utilisé"
                    },
                    "422": {
                        "description": "Données invalides"
                    }
                },
                "security": [
                    {
                        "cookieAuth": []
                    }
                ]
            }
        },
        "/api/v1/audit/logs": {
            "get": {
                "tags": [
                    "Audit"
                ],
                "summary": "Consulter les traces d'audit",
                "description": "Lecture seule. Les traces sont écrites côté serveur, jamais par le client.",
                "operationId": "fc1182b0b02ed272376654fe030ee93c",
                "responses": {
                    "200": {
                        "description": "Liste des traces"
                    },
                    "401": {
                        "description": "Non authentifié"
                    }
                },
                "security": [
                    {
                        "cookieAuth": []
                    }
                ]
            }
        },
        "/api/v1/auth/login": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Connexion",
                "description": "Ouvre une session cookie Sanctum. Aucun token n'est renvoyé.",
                "operationId": "48a612d50a32f0e30ee5df7edd67fdd5",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "jean.nuru@eglise-upn.org"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "password"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Session créée",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "properties": {
                                                "id": {
                                                    "type": "integer",
                                                    "example": 1
                                                },
                                                "name": {
                                                    "type": "string",
                                                    "example": "Jean Nuru"
                                                },
                                                "email": {
                                                    "type": "string",
                                                    "example": "jean.nuru@eglise-upn.org"
                                                },
                                                "statut": {
                                                    "type": "string",
                                                    "example": "actif"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Identifiants incorrects ou champs invalides"
                    }
                }
            }
        },
        "/api/v1/auth/logout": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Déconnexion",
                "description": "Détruit la session cookie. Aucun body.",
                "operationId": "87ffb7bbe23221ab1c3071598ed17932",
                "responses": {
                    "204": {
                        "description": "Session détruite"
                    },
                    "401": {
                        "description": "Non authentifié"
                    }
                },
                "security": [
                    {
                        "cookieAuth": []
                    }
                ]
            }
        },
        "/api/v1/auth/me": {
            "get": {
                "tags": [
                    "Auth"
                ],
                "summary": "Utilisateur connecté",
                "description": "Retourne le profil de la session courante. Aucun token.",
                "operationId": "ddf8a87fd060a99dbda2319e855b8448",
                "responses": {
                    "200": {
                        "description": "Profil de la session",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "properties": {
                                                "id": {
                                                    "type": "integer",
                                                    "example": 1
                                                },
                                                "name": {
                                                    "type": "string",
                                                    "example": "Jean Nuru"
                                                },
                                                "email": {
                                                    "type": "string",
                                                    "example": "jean.nuru@eglise-upn.org"
                                                },
                                                "statut": {
                                                    "type": "string",
                                                    "example": "actif"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Non authentifié"
                    }
                },
                "security": [
                    {
                        "cookieAuth": []
                    }
                ]
            }
        },
        "/api/v1/identite/comptes": {
            "post": {
                "tags": [
                    "Identité"
                ],
                "summary": "Créer un compte de connexion",
                "description": "Crée un User Laravel et le lie à une personne existante. Nécessite une session cookie. Le mot de passe n'est jamais renvoyé.",
                "operationId": "79872c4c5267924cbfe60deee25dc34f",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "id_personne",
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "id_personne": {
                                        "type": "string",
                                        "format": "uuid",
                                        "example": "849ba161-9f40-440c-ada3-2ebbb1279944"
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "bienvenu.karagi@eglise-upn.org"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "Secret123!"
                                    },
                                    "statut": {
                                        "type": "string",
                                        "example": "actif",
                                        "nullable": true,
                                        "enum": [
                                            "actif",
                                            "suspendu",
                                            "desactive"
                                        ]
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Compte créé"
                    },
                    "401": {
                        "description": "Non authentifié"
                    },
                    "404": {
                        "description": "Personne introuvable"
                    },
                    "409": {
                        "description": "Personne déjà liée ou email déjà utilisé"
                    },
                    "422": {
                        "description": "Données invalides"
                    }
                },
                "security": [
                    {
                        "cookieAuth": []
                    }
                ]
            }
        },
        "/api/v1/identite/personnes": {
            "post": {
                "tags": [
                    "Identité"
                ],
                "summary": "Créer une personne",
                "description": "Crée une fiche personne sans compte de connexion. Nécessite une session cookie.",
                "operationId": "ac5f3a9c9bd14a95d8848d4ed29dcaca",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "nom",
                                    "prenom"
                                ],
                                "properties": {
                                    "nom": {
                                        "type": "string",
                                        "example": "Nuru"
                                    },
                                    "prenom": {
                                        "type": "string",
                                        "example": "Jean"
                                    },
                                    "date_naissance": {
                                        "type": "string",
                                        "format": "date",
                                        "example": "1990-05-15",
                                        "nullable": true
                                    },
                                    "sexe": {
                                        "type": "string",
                                        "example": "M",
                                        "nullable": true,
                                        "enum": [
                                            "M",
                                            "F"
                                        ]
                                    },
                                    "telephone": {
                                        "type": "string",
                                        "example": "+243819999999",
                                        "nullable": true
                                    },
                                    "adresse": {
                                        "type": "string",
                                        "example": "Mont-Ngafula, Kinshasa",
                                        "nullable": true
                                    },
                                    "photo_url": {
                                        "type": "string",
                                        "nullable": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Personne créée"
                    },
                    "401": {
                        "description": "Non authentifié"
                    },
                    "422": {
                        "description": "Données invalides"
                    }
                },
                "security": [
                    {
                        "cookieAuth": []
                    }
                ]
            }
        },
        "/api/v1/organisation/personnes/{personne}/departements": {
            "post": {
                "tags": [
                    "Organisation"
                ],
                "summary": "Affecter une personne à un département",
                "description": "Crée une affectation active dans affecter_departement. Nécessite une session cookie. {personne} est l'UUID id_personne.",
                "operationId": "d8fde9ddff22f430314270a5076ddcf2",
                "parameters": [
                    {
                        "name": "personne",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid",
                            "example": "849ba161-9f40-440c-ada3-2ebbb1279944"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "id_departement"
                                ],
                                "properties": {
                                    "id_departement": {
                                        "type": "string",
                                        "format": "uuid"
                                    },
                                    "fonction": {
                                        "type": "string",
                                        "example": "Responsable accueil",
                                        "nullable": true
                                    },
                                    "date_debut": {
                                        "type": "string",
                                        "format": "date-time",
                                        "nullable": true
                                    },
                                    "date_fin": {
                                        "type": "string",
                                        "format": "date-time",
                                        "nullable": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Affectation créée"
                    },
                    "401": {
                        "description": "Non authentifié"
                    },
                    "404": {
                        "description": "Personne ou département introuvable"
                    },
                    "409": {
                        "description": "Personne déjà affectée à ce département"
                    },
                    "422": {
                        "description": "Données invalides"
                    }
                },
                "security": [
                    {
                        "cookieAuth": []
                    }
                ]
            }
        },
        "/api/v1/organisation/departements": {
            "post": {
                "tags": [
                    "Organisation"
                ],
                "summary": "Créer un département",
                "description": "Crée un département rattaché à un site existant. Nécessite une session cookie. Le code doit être unique.",
                "operationId": "537ef69834465350d7baea20ed3cd290",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "code",
                                    "nom",
                                    "id_site"
                                ],
                                "properties": {
                                    "code": {
                                        "type": "string",
                                        "example": "DEPT-ACCUEIL"
                                    },
                                    "nom": {
                                        "type": "string",
                                        "example": "Département Accueil"
                                    },
                                    "id_site": {
                                        "type": "string",
                                        "format": "uuid",
                                        "example": "11111111-1111-1111-1111-111111111111"
                                    },
                                    "mission": {
                                        "type": "string",
                                        "example": "Accueil des membres et visiteurs",
                                        "nullable": true
                                    },
                                    "actif": {
                                        "type": "boolean",
                                        "example": true,
                                        "nullable": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Département créé"
                    },
                    "401": {
                        "description": "Non authentifié"
                    },
                    "404": {
                        "description": "Site introuvable"
                    },
                    "409": {
                        "description": "Code de département déjà utilisé"
                    },
                    "422": {
                        "description": "Données invalides"
                    }
                },
                "security": [
                    {
                        "cookieAuth": []
                    }
                ]
            }
        },
        "/api/v1/organisation/sites": {
            "post": {
                "tags": [
                    "Organisation"
                ],
                "summary": "Créer un site",
                "description": "Crée un site (campus / lieu). Nécessite une session cookie. Le code doit être unique.",
                "operationId": "b3e6ea0863a60b8287fba24912b6b581",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "code",
                                    "nom",
                                    "telephone"
                                ],
                                "properties": {
                                    "code": {
                                        "type": "string",
                                        "example": "SITE-GOMBE-01"
                                    },
                                    "nom": {
                                        "type": "string",
                                        "example": "Site Gombe"
                                    },
                                    "telephone": {
                                        "type": "string",
                                        "example": "+243810000002"
                                    },
                                    "adresse": {
                                        "type": "string",
                                        "example": "Boulevard du 30 Juin, Gombe",
                                        "nullable": true
                                    },
                                    "ville": {
                                        "type": "string",
                                        "example": "Kinshasa",
                                        "nullable": true
                                    },
                                    "pays": {
                                        "type": "string",
                                        "example": "RDC",
                                        "nullable": true
                                    },
                                    "actif": {
                                        "type": "boolean",
                                        "example": true,
                                        "nullable": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Site créé"
                    },
                    "401": {
                        "description": "Non authentifié"
                    },
                    "409": {
                        "description": "Code de site déjà utilisé"
                    },
                    "422": {
                        "description": "Données invalides"
                    }
                },
                "security": [
                    {
                        "cookieAuth": []
                    }
                ]
            }
        }
    },
    "components": {
        "securitySchemes": {
            "cookieAuth": {
                "type": "apiKey",
                "description": "Cookie de session Sanctum (HttpOnly). Après POST /api/v1/auth/login, le navigateur l'envoie tout seul.",
                "name": "laravel_session",
                "in": "cookie"
            }
        }
    },
    "tags": [
        {
            "name": "Accès",
            "description": "Accès"
        },
        {
            "name": "Audit",
            "description": "Audit"
        },
        {
            "name": "Auth",
            "description": "Auth"
        },
        {
            "name": "Identité",
            "description": "Identité"
        },
        {
            "name": "Organisation",
            "description": "Organisation"
        }
    ]
}