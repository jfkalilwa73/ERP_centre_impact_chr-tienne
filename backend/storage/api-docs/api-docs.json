{
    "openapi": "3.0.0",
    "info": {
        "title": "Documentation API ERP Centre Impact Chrétien",
        "description": "API pour la gestion de l'ERP. Authentification SPA : cookie de session Sanctum, pas de Bearer token.",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8000",
            "description": "Serveur API principal"
        }
    ],
    "paths": {
        "/api/v1/acces/roles": {
            "post": {
                "tags": [
                    "Accès"
                ],
                "summary": "Créer un rôle métier",
                "description": "Crée un rôle (role_metier). Nécessite une session cookie. Le code doit être unique.",
                "operationId": "74842a32f6423bfc7ecd079d9fa8ff89",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "code",
                                    "nom"
                                ],
                                "properties": {
                                    "code": {
                                        "type": "string",
                                        "example": "ADMIN_FONCTIONNEL"
                                    },
                                    "nom": {
                                        "type": "string",
                                        "example": "Administrateur Fonctionnel"
                                    },
                                    "description": {
                                        "type": "string",
                                        "example": "Gestion globale de l'ERP",
                                        "nullable": true
                                    },
                                    "niveau_confidentialite": {
                                        "type": "integer",
                                        "example": 3,
                                        "nullable": true
                                    },
                                    "actif": {
                                        "type": "boolean",
                                        "example": true,
                                        "nullable": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Rôle créé"
                    },
                    "401": {
                        "description": "Non authentifié"
                    },
                    "409": {
                        "description": "Code de rôle déjà utilisé"
                    },
                    "422": {
                        "description": "Données invalides"
                    }
                },
                "security": [
                    {
                        "cookieAuth": []
                    }
                ]
            }
        },
        "/api/v1/auth/login": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Connexion",
                "description": "Ouvre une session cookie Sanctum. Aucun token n'est renvoyé.",
                "operationId": "48a612d50a32f0e30ee5df7edd67fdd5",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "jean.nuru@eglise-upn.org"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "password"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Session créée",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "properties": {
                                                "id": {
                                                    "type": "integer",
                                                    "example": 1
                                                },
                                                "name": {
                                                    "type": "string",
                                                    "example": "Jean Nuru"
                                                },
                                                "email": {
                                                    "type": "string",
                                                    "example": "jean.nuru@eglise-upn.org"
                                                },
                                                "statut": {
                                                    "type": "string",
                                                    "example": "actif"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Identifiants incorrects ou champs invalides"
                    }
                }
            }
        },
        "/api/v1/auth/logout": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Déconnexion",
                "description": "Détruit la session cookie. Aucun body.",
                "operationId": "87ffb7bbe23221ab1c3071598ed17932",
                "responses": {
                    "204": {
                        "description": "Session détruite"
                    },
                    "401": {
                        "description": "Non authentifié"
                    }
                },
                "security": [
                    {
                        "cookieAuth": []
                    }
                ]
            }
        },
        "/api/v1/auth/me": {
            "get": {
                "tags": [
                    "Auth"
                ],
                "summary": "Utilisateur connecté",
                "description": "Retourne le profil de la session courante. Aucun token.",
                "operationId": "ddf8a87fd060a99dbda2319e855b8448",
                "responses": {
                    "200": {
                        "description": "Profil de la session",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "properties": {
                                                "id": {
                                                    "type": "integer",
                                                    "example": 1
                                                },
                                                "name": {
                                                    "type": "string",
                                                    "example": "Jean Nuru"
                                                },
                                                "email": {
                                                    "type": "string",
                                                    "example": "jean.nuru@eglise-upn.org"
                                                },
                                                "statut": {
                                                    "type": "string",
                                                    "example": "actif"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Non authentifié"
                    }
                },
                "security": [
                    {
                        "cookieAuth": []
                    }
                ]
            }
        },
        "/api/v1/identite/comptes": {
            "post": {
                "tags": [
                    "Identité"
                ],
                "summary": "Créer un compte de connexion",
                "description": "Crée un User Laravel et le lie à une personne existante. Nécessite une session cookie. Le mot de passe n'est jamais renvoyé.",
                "operationId": "79872c4c5267924cbfe60deee25dc34f",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "id_personne",
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "id_personne": {
                                        "type": "string",
                                        "format": "uuid",
                                        "example": "849ba161-9f40-440c-ada3-2ebbb1279944"
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "bienvenu.karagi@eglise-upn.org"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "Secret123!"
                                    },
                                    "statut": {
                                        "type": "string",
                                        "example": "actif",
                                        "nullable": true,
                                        "enum": [
                                            "actif",
                                            "suspendu",
                                            "desactive"
                                        ]
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Compte créé"
                    },
                    "401": {
                        "description": "Non authentifié"
                    },
                    "404": {
                        "description": "Personne introuvable"
                    },
                    "409": {
                        "description": "Personne déjà liée ou email déjà utilisé"
                    },
                    "422": {
                        "description": "Données invalides"
                    }
                },
                "security": [
                    {
                        "cookieAuth": []
                    }
                ]
            }
        },
        "/api/v1/identite/personnes": {
            "post": {
                "tags": [
                    "Identité"
                ],
                "summary": "Créer une personne",
                "description": "Crée une fiche personne sans compte de connexion. Nécessite une session cookie.",
                "operationId": "ac5f3a9c9bd14a95d8848d4ed29dcaca",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "nom",
                                    "prenom"
                                ],
                                "properties": {
                                    "nom": {
                                        "type": "string",
                                        "example": "Nuru"
                                    },
                                    "prenom": {
                                        "type": "string",
                                        "example": "Jean"
                                    },
                                    "date_naissance": {
                                        "type": "string",
                                        "format": "date",
                                        "example": "1990-05-15",
                                        "nullable": true
                                    },
                                    "sexe": {
                                        "type": "string",
                                        "example": "M",
                                        "nullable": true,
                                        "enum": [
                                            "M",
                                            "F"
                                        ]
                                    },
                                    "telephone": {
                                        "type": "string",
                                        "example": "+243819999999",
                                        "nullable": true
                                    },
                                    "adresse": {
                                        "type": "string",
                                        "example": "Mont-Ngafula, Kinshasa",
                                        "nullable": true
                                    },
                                    "photo_url": {
                                        "type": "string",
                                        "nullable": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Personne créée"
                    },
                    "401": {
                        "description": "Non authentifié"
                    },
                    "422": {
                        "description": "Données invalides"
                    }
                },
                "security": [
                    {
                        "cookieAuth": []
                    }
                ]
            }
        }
    },
    "components": {
        "securitySchemes": {
            "cookieAuth": {
                "type": "apiKey",
                "description": "Cookie de session Sanctum (HttpOnly). Après POST /api/v1/auth/login, le navigateur l'envoie tout seul.",
                "name": "laravel_session",
                "in": "cookie"
            }
        }
    },
    "tags": [
        {
            "name": "Accès",
            "description": "Accès"
        },
        {
            "name": "Auth",
            "description": "Auth"
        },
        {
            "name": "Identité",
            "description": "Identité"
        }
    ]
}