# Base de l'API, version incluse : le contrat Phase 0 expose /api/v1
VITE_API_URL=http://localhost:8000/api/v1
VITE_APP_NAME="ERP Église"
VITE_APP_ENV=development

# Mettre à true pour simuler l'API avec MSW (src/mocks) quand le backend n'est pas disponible.
# Laisser à false en développement normal pour taper le vrai backend.
VITE_USE_MOCKS=false
